{
  "name": "bysarahkim-cms-auth",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "auth.bysarahkim.com",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": false },
  "vars": {
    "SITE_ORIGIN": "https://bysarahkim.com",
    "GITHUB_OWNER": "bysarahkim",
    "GITHUB_REPO": "bysarahkim.com"
  }
}
